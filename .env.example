# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- MongoDB ----
# MongoDB Atlas (free tier works) or local MongoDB.
# Leave empty in development to use a temporary in-memory database (data is lost on restart).
MONGODB_URI=

# ---- Admin dashboard login (/admin) ----
# Used ONLY to create the first admin in the database when none exists.
# Afterwards add/reset logins with: npm run seed:admin -- <id> <password>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
# Long random string used to sign admin login sessions
JWT_SECRET=change-this-to-a-long-random-string

# ---- Razorpay (https://dashboard.razorpay.com -> Account & Settings -> API Keys) ----
# Easier: enter the keys in Dashboard -> Settings -> Payment gateway (they override these and are stored
# encrypted with JWT_SECRET; if you change JWT_SECRET, re-enter them there). These are only the fallback.
# Use rzp_test_... keys for testing, rzp_live_... keys for real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Razorpay -> Webhooks -> URL: https://YOURDOMAIN/api/razorpay/webhook,
# events: payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# When Razorpay keys are empty, DEMO_PAYMENTS=true shows a "simulate payment" button
# so you can test the whole flow. Never enable in production.
DEMO_PAYMENTS=true

# Prefix for order numbers, e.g. SONG-261124-7KQ2
ORDER_PREFIX=SONG

# Load PREVIEW content on first start (stock photos, demo songs, sample reviews). Set to false before going live.
DEMO_CONTENT=false
